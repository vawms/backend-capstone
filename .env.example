# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_service
POSTGRES_PORT=5432

# Backend app
PORT=3000
DATABASE_URL=postgres://postgres:postgres@postgres:5432/smart_service
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=smart_service
NODE_ENV=development
JWT_SECRET=super-secret
JWT_ACCESS_SECRET=super-secret
JWT_REFRESH_SECRET=super-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QA only — set to true to seed sample data on startup
RUN_SEED=false
